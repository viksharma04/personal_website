# S3 configuration for the /api/[...path] texture proxy (used by the 3D room).
# Copy this file to .env.local and fill in real values. All four are required;
# a missing one makes /api/textures/... return 500 "S3 is not configured".

S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
